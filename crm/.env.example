# ── Base de datos ───────────────────────────────────────────────
# Opción A (recomendada, la que usa producción): Postgres gestionado — Supabase
# u otro compatible. Si defines DATABASE_URL/DATABASE_DIRECT_URL, estas dos
# tienen prioridad y las variables POSTGRES_*/DB_HOST/APP_DB_* de abajo se
# ignoran. NO pongas "?sslmode=require" en la query string: pg 8.x lo trata
# como verify-full e ignora la opción ssl que pasa el código, y falla con
# "self-signed certificate in certificate chain" contra el pooler.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DATABASE_DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_DIRECT_URL=

# Opción B: Postgres en Docker local (docker-compose.yml) o en el VPS de la
# vía autoalojada (docker-compose.dokploy.yml). Solo se usan si las dos
# variables de arriba están vacías.
POSTGRES_USER=oficina_jr
POSTGRES_PASSWORD=oficina_jr_dev_pass
POSTGRES_DB=oficina_jr

# Configuración de conexión para la aplicación y scripts (solo Opción B).
# En desarrollo: DB_HOST=localhost; en Dokploy (producción autoalojada): DB_HOST=db
DB_HOST=localhost
DB_PORT=5435

# Rol de aplicación (sin BYPASSRLS ni SUPERUSER) con el que se conecta el runtime web (solo Opción B).
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user_dev_pass

# ── Aplicación ──────────────────────────────────────────────────
# En desarrollo: URL de Tailscale Funnel (https://<equipo>.<tailnet>.ts.net) si
# vas a probar con llamadas reales de VAPI; si no, http://localhost:3000 basta.
# En producción con Vercel: el dominio que te asigne (https://tu-proyecto.vercel.app)
# o tu dominio propio. En producción autoalojada: https://<tu-dominio.com>
APP_URL=http://localhost:3000

# Solo para la vía autoalojada (Dokploy / Traefik): nombre de dominio sin
# protocolo. En Vercel o en desarrollo se deja vacío.
APP_DOMAIN=

# ── VAPI (Plataforma de Voz) ────────────────────────────────────
# Clave privada de API de VAPI. Jamás exponer al cliente ni prefijar con NEXT_PUBLIC_.
VAPI_API_KEY=

# ID de la Custom Credential Bearer creada en el dashboard de VAPI (Dashboard > Custom Credentials).
VAPI_SERVER_CREDENTIAL_ID=

# Token Bearer secreto que viaja en la cabecera 'Authorization: Bearer <token>' configurada en dicha credencial.
VAPI_WEBHOOK_TOKEN=

# Opcional: cuenta propia de ElevenLabs en vez del pool compartido de VAPI.
# ELEVENLABS_API_KEY solo se usa para crear/rotar a mano la Custom Credential
# "11labs" en VAPI; el código en producción solo lee ELEVENLABS_CREDENTIAL_ID
# (el ID de esa credencial ya creada). Requiere plan de pago de ElevenLabs
# para usar voces de la Biblioteca (como la voz por defecto "Carolina") vía
# API — el plan gratuito lo bloquea.
ELEVENLABS_API_KEY=
ELEVENLABS_CREDENTIAL_ID=

# ── Localización & CRM ──────────────────────────────────────────
DEFAULT_TIMEZONE=America/Santo_Domingo
DEFAULT_COUNTRY_CODE=DO

# ── Landing pública (Oficina Jacobo Ramos) ──────────────────────
# ID de la oficina que recibe las solicitudes del formulario web. Lo imprime
# `pnpm db:seed` al terminar (línea OFICINA_BUSINESS_ID=...). Sin esto la API pública responde 503.
OFICINA_BUSINESS_ID=

# Orígenes (separados por comas, sin barra final) desde los que la landing puede llamar a la API.
# En local: http://localhost:8000. En producción: el dominio real de la landing. Nunca uses "*".
LANDING_ALLOWED_ORIGINS=http://localhost:8000

# Registro abierto de cuentas. Déjalo en false: este panel es de una sola oficina.
ALLOW_SIGNUP=false

# ── Solo para `pnpm db:seed` (primer administrador) ─────────────
# No hay usuario ni contraseña por defecto. Define estas variables, ejecuta el semillero y bórralas del .env.
# La contraseña debe tener al menos 12 caracteres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
